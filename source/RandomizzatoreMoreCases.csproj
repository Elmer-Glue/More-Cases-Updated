<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RandomizzatoreMoreCases</RootNamespace>
    <AssemblyName>RandomizzatoreMoreCases</AssemblyName>
  </PropertyGroup>

  <!-- Game install location. Override without editing this file via:
       dotnet build -p:GameDir="D:\Other\Path"  (or a GameDir environment variable) -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Games\SPT\SPT 41\SPT 41 Game</GameDir>
    <SptServerDir>$(GameDir)\SPT_Runtime</SptServerDir>
    <SptModsDir>$(SptServerDir)\user\mods</SptModsDir>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="**\*.json" />
    <None Remove="**\*.bundle" />
  </ItemGroup>

  <!-- Server DLLs come straight from the SPT install; Private=false so they aren't copied to the output. -->
  <ItemGroup>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SptServerDir)\SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SptServerDir)\SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SptServerDir)\SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SptServerDir)\SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- WTT-ServerCommonLib is itself a server mod, so it lives under user\mods -->
    <Reference Include="WTT-ServerCommonLib">
      <HintPath>$(SptModsDir)\WTT-ServerCommonLib\WTT-ServerCommonLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Fail early with a readable message if the game folder or a DLL isn't where expected. -->
  <Target Name="CheckGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(SptServerDir)')"
           Text="SPT server folder not found: $(SptServerDir). Set GameDir (currently '$(GameDir)')." />
    <Error Condition="!Exists('$(SptServerDir)\SPTarkov.Server.Core.dll')"
           Text="SPTarkov.Server.Core.dll not found in $(SptServerDir)." />
    <Error Condition="!Exists('$(SptModsDir)\WTT-ServerCommonLib\WTT-ServerCommonLib.dll')"
           Text="WTT-ServerCommonLib.dll not found in $(SptModsDir)\WTT-ServerCommonLib. Install the WTT-ServerCommonLib mod in that game folder first." />
  </Target>

</Project>
